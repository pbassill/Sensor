# =============================================================================
# Sensor configuration
# -----------------------------------------------------------------------------
# This is the ONLY file you need to edit. Copy it to "sensor.conf", fill in the
# values for your site, then run ./configure.sh followed by docker compose up -d.
#
# Every value below is substituted into the Wazuh and Fluent Bit configuration
# when you run ./configure.sh. Do not commit sensor.conf - it holds secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Central connectivity
# -----------------------------------------------------------------------------
# One load balancer fronts your central estate: the Wazuh cluster master, the
# Wazuh API, and Graylog. Set it once here and it is reused everywhere below.
#
# Outbound ports this sensor needs to reach CENTRAL_HOST:
#   1516  Wazuh cluster sync   (worker -> master)         [required]
#   55000 Wazuh API                                       [required]
#   55001 Graylog (Fluent Bit json_lines)                 [required]
#   1514  Wazuh agent events   (only if you route via it) [optional]
#   1515  Wazuh agent enrol     (only if you route via it) [optional]
CENTRAL_HOST=xdr.lon.cyber-defence.io

# -----------------------------------------------------------------------------
# Wazuh cluster
# -----------------------------------------------------------------------------
# This sensor runs a Wazuh manager as a WORKER node that joins your central
# Wazuh cluster. The worker connects OUTBOUND to the master (CENTRAL_HOST) on
# the cluster port. Local agents on this internal network report to this worker.

# A friendly name for your cluster. MUST match the name configured on the master.
WAZUH_CLUSTER_NAME=reeve-cluster

# Unique name for THIS sensor node within the cluster (no spaces).
WAZUH_NODE_NAME=sensor-01

# Node type. Keep this as "worker" - the master lives on your central cluster.
WAZUH_NODE_TYPE=worker

# Cluster key. MUST be identical to the key on the master and every other node.
# Generate one on the master with: openssl rand -hex 16
WAZUH_CLUSTER_KEY=CHANGE_ME_32_HEX_CHARACTERS_000000

# Cluster sync port that the load balancer routes to the master (default 1516).
WAZUH_CLUSTER_PORT=1516

# Central Wazuh API port (the worker/manager reaches this on CENTRAL_HOST).
WAZUH_API_PORT=55000

# Set to "no" to enable clustering, "yes" to run this manager standalone.
WAZUH_CLUSTER_DISABLED=no

# -----------------------------------------------------------------------------
# Local agent enrollment
# -----------------------------------------------------------------------------
# Password used by local agents to auto-enroll against this sensor (port 1515).
# Set a strong value and use the same password in the agent install commands.
WAZUH_REGISTRATION_PASSWORD=CHANGE_ME_enrollment_password

# -----------------------------------------------------------------------------
# Log forwarding (Fluent Bit)
# -----------------------------------------------------------------------------
# Fluent Bit tails the Wazuh alerts and forwards them over TCP (json_lines) to
# Graylog, which sits behind CENTRAL_HOST on the port below.

# Graylog json_lines input port on the load balancer (default 55001).
LOG_DEST_PORT=55001

# How often (seconds) Fluent Bit flushes buffered records to the collector.
FLUENT_BIT_FLUSH=5

# Also forward the full Wazuh archives (every event, not just alerts).
# "true" is high volume - only enable if the collector is sized for it.
FORWARD_ARCHIVES=false

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
# Wazuh version. Manager and agents should match this major.minor version, and
# it MUST match the version running on your central cluster master.
WAZUH_VERSION=4.9.2

# Timezone for the containers (IANA name).
SENSOR_TIMEZONE=Europe/London
