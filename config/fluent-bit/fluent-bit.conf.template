# =============================================================================
# Fluent Bit configuration for the Sensor.
# This file is a TEMPLATE. Values in ${...} are filled in from sensor.conf by
# ./configure.sh. Do not edit generated/fluent-bit/fluent-bit.conf directly -
# edit sensor.conf and re-run ./configure.sh.
#
# Fluent Bit tails the Wazuh manager's alert files and ships them over TCP
# (json_lines) to the central collector defined in sensor.conf.
# =============================================================================

[SERVICE]
    flush                     ${FLUENT_BIT_FLUSH}
    daemon                    Off
    log_level                 info
    parsers_file              parsers.conf
    plugins_file              plugins.conf
    http_server               On
    http_listen               0.0.0.0
    http_port                 2020
    storage.metrics           on
    storage.path              /var/log/flb-storage/
    storage.sync              normal
    storage.checksum          off
    storage.backlog.mem_limit 128M
    Log_File                  /var/log/td-agent-bit.log

# ---- Wazuh JSON alerts (level >= log_alert_level in ossec.conf) ----
[INPUT]
    name              tail
    path              /var/ossec/logs/alerts/alerts.json
    tag               wazuh
    parser            json
    Buffer_Max_Size   5MB
    Buffer_Chunk_Size 400k
    storage.type      filesystem
    Mem_Buf_Limit     512MB

# ---- Wazuh full archives (every event) - only present if FORWARD_ARCHIVES=true.
# The file simply won't exist when archives are disabled, so this input idles.
[INPUT]
    name              tail
    path              /var/ossec/logs/archives/archives.json
    tag               wazuh
    parser            json
    Buffer_Max_Size   5MB
    Buffer_Chunk_Size 400k
    storage.type      filesystem
    Mem_Buf_Limit     512MB

# ---- Tag every record with this sensor's identity so the collector can tell
#      one internal-network sensor from another across the fleet. ----
[FILTER]
    Name    record_modifier
    Match   wazuh
    Record  sensor_node ${WAZUH_NODE_NAME}
    Record  cluster ${WAZUH_CLUSTER_NAME}

# ---- Forward to the central collector (Graylog / XDR) ----
[OUTPUT]
    Name          tcp
    Host          ${LOG_DEST_HOST}
    Port          ${LOG_DEST_PORT}
    net.keepalive on
    Match         wazuh
    Format        json_lines
    json_date_key true
